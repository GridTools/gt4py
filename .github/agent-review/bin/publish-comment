#!/usr/bin/env bash
# Validates the agent's review and upserts it as a PR comment.
#
# Usage:
#   publish-comment sanitize                      < review > safe-review
#   publish-comment render --harness H --version V --model M --run-url U --review FILE
#   publish-comment post --repo R --pr N --harness H --body-file FILE
#
# Runs in the 'publish' job: a fresh VM with a write-capable token, no model
# and no PR code. The review is model output steered by untrusted PR content,
# so it is treated as hostile text:
#   - it must be valid UTF-8; control characters are dropped;
#   - HTML comment delimiters are broken up, so the review can neither hide
#     text nor imitate the marker that identifies this workflow's comment;
#   - @mentions are neutralised with a zero-width joiner after the '@';
#   - it is truncated to REVIEW_MAX_BYTES.
# 'sanitize' and 'render' only read stdin/files and write stdout, so they are
# tested offline (tests/test-publish-comment.sh); only 'post' uses the network.

set -euo pipefail
shopt -u patsub_replacement 2>/dev/null || true
export LC_ALL=C

readonly REVIEW_MAX_BYTES=60000
# GitHub rejects comment bodies over 65536 characters.
readonly BODY_MAX_BYTES=65536
readonly ZWSP=$'\xe2\x80\x8b' # zero-width space
readonly ZWJ=$'\xe2\x80\x8d'  # zero-width joiner
BOT_LOGIN=${BOT_LOGIN:-github-actions[bot]}

die() {
  echo "publish-comment: $*" >&2
  exit 1
}

# Byte truncation can split a multi-byte character at the end; 'iconv -c'
# drops it, and exits 1 when it does.
drop_partial_chars() { iconv -f UTF-8 -t UTF-8 -c 2>/dev/null || true; }

marker() { printf '<!-- agent-review:%s -->' "$1"; }

# Exit code 3: the input is not valid UTF-8 (the caller posts nothing).
cmd_sanitize() {
  local input cleaned
  input=$(mktemp)
  cleaned=$(mktemp)
  # shellcheck disable=SC2064 # expand now: the locals are gone on return
  trap "rm -f '${input}' '${cleaned}'" RETURN
  cat >"${input}"
  iconv -f UTF-8 -t UTF-8 <"${input}" >/dev/null 2>&1 || {
    echo "publish-comment: the review is not valid UTF-8." >&2
    return 3
  }
  # Keep tab and newline; drop other C0 controls and DEL (CR included).
  # The replacements cannot create new matches: neither inserts '<' or '>'.
  tr -d '\000-\010\013-\037\177' <"${input}" |
    sed -e "s/<!--/<!${ZWSP}--/g" \
      -e "s/-->/--${ZWSP}>/g" \
      -e "s/@\([A-Za-z0-9]\)/@${ZWJ}\1/g" >"${cleaned}"
  # Truncated from a file, not in the pipeline: 'head' closing the pipe early
  # would kill the writer with SIGPIPE, which 'pipefail' reports as a failure.
  head -c "${REVIEW_MAX_BYTES}" "${cleaned}" | drop_partial_chars
}

check_label() { # name value
  [[ "$2" =~ ^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$ ]] || die "Invalid $1 '$2'."
}

cmd_render() {
  local harness="" version="" model="" run_url="" review=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --harness) harness=$2 ;;
      --version) version=$2 ;;
      --model) model=$2 ;;
      --run-url) run_url=$2 ;;
      --review) review=$2 ;;
      *) die "Unknown option '$1'." ;;
    esac
    shift 2
  done
  # These come from the workflow's trusted job outputs, never from the
  # sandbox; validated because they are interpolated into Markdown.
  check_label harness "${harness}"
  check_label version "${version}"
  check_label model "${model}"
  [[ "${run_url}" =~ ^https://github\.com/[A-Za-z0-9_./-]+$ ]] || die "Invalid run URL '${run_url}'."
  [ -f "${review}" ] || die "No review file '${review}'."

  local safe
  safe=$(cmd_sanitize <"${review}") || return $?
  [ -n "${safe//[[:space:]]/}" ] || { echo "publish-comment: the review is empty." >&2; return 3; }
  local original_bytes
  original_bytes=$(stat -c %s -- "${review}")

  marker "${harness}"
  printf '\n> [!NOTE]\n'
  # shellcheck disable=SC2016 # the backticks are Markdown
  printf '> Advisory review by **%s** %s (`%s`), produced in a sandbox. ' "${harness}" "${version}" "${model}"
  printf 'Not a required check; it may be wrong. [Workflow run](%s).\n\n' "${run_url}"
  printf '%s\n' "${safe}"
  if [ "${#safe}" -ge "${REVIEW_MAX_BYTES}" ] || [ "${original_bytes}" -gt "${REVIEW_MAX_BYTES}" ]; then
    printf '\n_[Truncated to %d bytes.]_\n' "${REVIEW_MAX_BYTES}"
  fi
}

cmd_post() {
  local repo="" pr="" harness="" body_file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo=$2 ;;
      --pr) pr=$2 ;;
      --harness) harness=$2 ;;
      --body-file) body_file=$2 ;;
      *) die "Unknown option '$1'." ;;
    esac
    shift 2
  done
  [[ "${repo}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "Invalid repo '${repo}'."
  [[ "${pr}" =~ ^[1-9][0-9]{0,9}$ ]] || die "Invalid PR number '${pr}'."
  check_label harness "${harness}"
  [ -f "${body_file}" ] || die "No body file '${body_file}'."
  [ "$(stat -c %s -- "${body_file}")" -le "${BODY_MAX_BYTES}" ] || die "The comment body exceeds ${BODY_MAX_BYTES} bytes."

  local want
  want=$(marker "${harness}")
  [ "$(head -n 1 -- "${body_file}")" = "${want}" ] || die "The body does not start with the marker."

  # The marker is matched only on this workflow's own comments, and on the
  # first line only: never 'gh pr comment --edit-last', since PR Agent posts
  # as the same bot. The sanitiser keeps the review from containing it.
  local id="" cid login first
  # '|| [ -n ... ]' also handles a last line without a newline.
  while IFS=$'\t' read -r cid login first || [ -n "${cid}" ]; do
    if [ "${login}" = "${BOT_LOGIN}" ] && [ "${first}" = "${want}" ]; then
      id=${cid}
      break
    fi
  done < <(gh api --paginate "repos/${repo}/issues/${pr}/comments?per_page=100" \
    --jq '.[] | [.id, .user.login, (.body | split("\n") | .[0])] | @tsv')

  if [ -n "${id}" ]; then
    jq -Rsc '{body: .}' <"${body_file}" |
      gh api -X PATCH "repos/${repo}/issues/comments/${id}" --input - --jq '.html_url'
  else
    jq -Rsc '{body: .}' <"${body_file}" |
      gh api -X POST "repos/${repo}/issues/${pr}/comments" --input - --jq '.html_url'
  fi
}

[ $# -ge 1 ] || die "Usage: publish-comment sanitize|render|post [options]"
command=$1
shift
case "${command}" in
  sanitize) cmd_sanitize "$@" ;;
  render) cmd_render "$@" ;;
  post) cmd_post "$@" ;;
  *) die "Unknown command '${command}'." ;;
esac
